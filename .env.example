# Copy to .env and configure every secret before a shared deployment.
# These values are for local development only.

POSTGRES_PASSWORD=ragflow_dev_password
DATABASE_URL=postgresql+psycopg://ragflow:ragflow_dev_password@localhost:5432/ragflow

# Required. At least 32 characters. Replace the value below — the API refuses
# to start if JWT_SECRET is missing or still equals this placeholder.
JWT_SECRET=

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

CORS_ORIGINS=http://localhost:5173

# Optional. Used only when the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Admin

LOG_LEVEL=INFO

# Original document bytes (gitignored). Relative to apps/api when running uvicorn there.
STORAGE_DIR=storage
MAX_UPLOAD_BYTES=26214400

# Declared for later phases. Phase 1 does not call these services.
GEMINI_API_KEY=
GEMINI_MODEL=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Leave empty to record library_version+model_id on first load (D6).
EMBEDDING_REVISION=
# Set to 1 for pytest and local runs without downloading weights.
EMBEDDING_USE_FAKE=
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
